    {
      "id": "c4e8a1b2-6d3f-4a91-8c20-0b1e5f7a1006",
      "name": "Choose unsent bookings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const settings = Object.fromEntries(\n  $(\"Read settings\").all().map((item) => [item.json.key, String(item.json.value ?? \"\")]),\n);\nconst serviceName = Object.fromEntries(\n  $(\"Read services\").all().map((item) => [item.json.service_id, String(item.json.name ?? \"\")]),\n);\n\nconst due = $input.all().map((item) => item.json).filter((booking) => {\n  return String(booking.status ?? \"\").trim() === \"confirmed\" && String(booking.owner_notified_at ?? \"\").trim() === \"\";\n});\n\nconst notifiedAt = salonStamp(settings.timezone);\n\nreturn due.map((booking) => {\n  const phone = String(booking.customer_phone ?? \"\").trim();\n  const name = serviceName[booking.service_id] || booking.service_id;\n  const text = [\n    `New appointment at ${settings.business_name}`,\n    \"\",\n    booking.customer_name,\n    booking.customer_email,\n    phone || \"No phone number\",\n    \"\",\n    name,\n    `${longDate(booking.date)}, ${booking.start_time}–${booking.end_time}`,\n    \"\",\n    `Booking ${booking.booking_id}`,\n  ].join(\"\\n\");\n\n  return {\n    json: {\n      booking_id: booking.booking_id,\n      to: settings.salon_email,\n      subject: `New booking: ${booking.customer_name}, ${booking.date} ${booking.start_time}`,\n      text,\n      owner_notified_at: notifiedAt,\n    },\n  };\n});\n\nfunction longDate(date) {\n  const [year, month, day] = date.split(\"-\").map(Number);\n  return new Intl.DateTimeFormat(\"en-US\", {\n    weekday: \"long\",\n    month: \"long\",\n    day: \"numeric\",\n    year: \"numeric\",\n    timeZone: \"UTC\",\n  }).format(new Date(Date.UTC(year, month - 1, day)));\n}\n\nfunction salonStamp(timeZone) {\n  const now = new Date();\n  const parts = new Intl.DateTimeFormat(\"en-US\", {\n    timeZone,\n    year: \"numeric\",\n    month: \"2-digit\",\n    day: \"2-digit\",\n    hour: \"2-digit\",\n    minute: \"2-digit\",\n    second: \"2-digit\",\n    hourCycle: \"h23\",\n  }).formatToParts(now);\n  const value = Object.fromEntries(parts.filter((part) => part.type !== \"literal\").map((part) => [part.type, part.value]));\n  const year = Number(value.year);\n  const month = Number(value.month);\n  const day = Number(value.day);\n  const hour = Number(value.hour) % 24;\n  const minute = Number(value.minute);\n  const second = Number(value.second);\n  const offsetMinutes = Math.round((Date.UTC(year, month - 1, day, hour, minute, second) - now.getTime()) / 60000);\n  const sign = offsetMinutes >= 0 ? \"+\" : \"-\";\n  const absolute = Math.abs(offsetMinutes);\n  const pad = (part) => String(part).padStart(2, \"0\");\n  return `${year}-${pad(month)}-${pad(day)}T${pad(hour)}:${pad(minute)}:${pad(second)}${sign}${pad(Math.floor(absolute / 60))}:${pad(absolute % 60)}`;\n}\n"
      }
